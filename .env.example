# Supabase — required for database + storage. Get from https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket created/used for question figure images
SUPABASE_STORAGE_BUCKET=question-images

# AgentRouter LLM fallback (gpt-5.6-sol). Leave key empty to run deterministic-only;
# ambiguous/low-confidence items will be marked needs_review instead of LLM-assisted.
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-5.6-sol

# Admin UI password (signs an HttpOnly cookie session)
ADMIN_PASSWORD=

# Questions at/above this extraction confidence are auto-approved; below are needs_review
CONFIDENCE_THRESHOLD=0.8

# Pipeline options
# RENDER_DPI_SCALE=2.5
# MAX_IMAGE_WIDTH=1400
